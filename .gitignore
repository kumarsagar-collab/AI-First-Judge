# Keep the Results folder tracked but ignore all its contents
Results/*
!Results/.gitkeep

# Keep the WorkShopSubmission folder tracked but ignore all its contents
WorkShopSubmission/*
!WorkShopSubmission/.gitkeep

# Secrets and credentials (never commit)
*.env
.env
.env.*
config.toml
.proposal-judge-state.json
*.pem
*.key
*.pfx
*.p12

# Python virtual environments and caches
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/

# SharePoint local cache/staging
.sharepoint-cache/

# Local source challenge artifacts
/Reference/

# Local environment noise
*.tmp
Thumbs.db
.DS_Store
